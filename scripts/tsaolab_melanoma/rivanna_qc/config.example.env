# Greek melanoma Rivanna quantification: example configuration.
#
# Copy outside the repository, edit, then:   source /path/to/my_config.env
# Every script reads these variables from the environment; nothing here is required to live in git.
# Values marked [user-reported] were observed on Rivanna by the user and are not verified by these scripts
# until the corresponding verification step runs.

# ---- scripts (Slurm runs a spooled copy of each .sbatch, so the library location must be explicit) ----
export RQC_DIR=/path/to/DermTrace/scripts/tsaolab_melanoma/rivanna_qc

# ---- filesystem layout --------------------------------------------------------------------------------
export MELANOMA_ROOT=/scratch/USERNAME/greek_melanoma          # project root on Rivanna
export RAW_DIR="$MELANOMA_ROOT/raw_fastq"                      # raw FASTQs (read-only input)
export SAMPLE_SHEET="$MELANOMA_ROOT/samples_20088-11.csv"     # copy of data/processed/tsaolab_melanoma/sample_sheets/samples_20088-11.csv
export VALIDATED_PAIRS="$MELANOMA_ROOT/validated_pairs.tsv"   # gzip-validated pairs (SAMPLE<TAB>R1<TAB>R2); eligibility gate
# Built-in exclusions (always applied): 20088XR-11-37 (provenance adjudication pending) and corrupt
# 20088XR-11-43/44/46/47/48. Add more here; lift a built-in only with a recorded reference, e.g.
#   LIFT_EXCLUSIONS="20088XR-11-37=<adjudication record>"
export EXCLUDED_SPECIMENS=""
export LIFT_EXCLUSIONS=""
export REF_DIR="$MELANOMA_ROOT/references/gencode_human_v46"
export INDEX_DIR="$REF_DIR/salmon_index_k31"
export CONTAINER_DIR="$MELANOMA_ROOT/containers"
export QUANT_ROOT="$MELANOMA_ROOT/quant_v46_candidate"         # one sub-directory per specimen; never overwritten
export PROVENANCE_DIR="$MELANOMA_ROOT/provenance"

# ---- software (Lmod) ----------------------------------------------------------------------------------
export SALMON_MODULES="gcc/14.2.0 salmon/1.10.3"
export APPTAINER_MODULES="apptainer"
export PYTHON_BIN=python3                                      # [user-reported] Python 3.13.14
export RQC_MODULE_PURGE=1                                      # each step: module purge, then load only its own modules
export EXPECT_SALMON=1.10.3

# ---- GENCODE v46 reference ----------------------------------------------------------------------------
export GENCODE_BASE_URL=https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_46
export GENCODE_TRANSCRIPTS=gencode.v46.transcripts.fa.gz
export GENCODE_TRANSCRIPTS_MD5=f1549843717b0fecfa4336fe3d5cc85f   # [user-reported]

# ---- Salmon index (candidate configuration matching the committed collaborator runs) -------------------
export SALMON_KMER=31                                          # candidate; [user-reported] Rivanna index info.json k=31. Collaborator k unverified
export SALMON_INDEX_THREADS=8
# Fingerprints recorded in all 33 committed meta_info.json files (data/processed/tsaolab_melanoma/salmon_quant/*/aux_info/).
# [user-reported] The Rivanna index built with --gencode -k 31 (job 23390691) matched all six:
#   SeqHash, NameHash, SeqHash512, NameHash512, DecoySeqHash, DecoyNameHash.
# The k-mer length is NOT part of these fingerprints: the collaborator's original k remains unverified.
export EXPECT_SEQ_HASH=9edf59907918a715a58542b94221f7ad7d88c2edf40104a2ce1834a37c9df644
export EXPECT_NAME_HASH=11bd2542a03abacba2f4ba1e5f2a8b8a8402fd88fc3e55050569893fa17b4b94
export EXPECT_SEQ_HASH512=7eb64cfebb1fa1ea843da8e5a570842a873c09f177bd57815fd01390d5a1ae56ffef711b9100383eb57cb786473d5c45baed292699bc91cadeaeb498f2446a19
export EXPECT_NAME_HASH512=b22b5cb3f38f0a919fc7a2a834f044c92b90ffc19ade1e4abc40ecf520b2b58ffd7b4f57a73028fe0c4a83b01bef6c591d113aa3f662d7ad620f72dca0d5ac3d
export EXPECT_DECOY_HASH=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855   # SHA-256 of empty input: no decoys

# ---- fastp container (CANDIDATE version: the collaborator's fastp version is unknown) -------------------
export FASTP_IMAGE_URI=docker://quay.io/biocontainers/fastp:0.23.4--h125f33a_5
export FASTP_SIF="$CONTAINER_DIR/fastp_0.23.4--h125f33a_5.sif"
export FASTP_SIF_SHA256=ef059319ad789e51ab2b40bae48f110b32f2675deeff67052b0ba2f8a21c3e01   # [user-reported] observed SIF
export FASTP_EXPECTED_VERSION=0.23.4                           # [user-reported] container reports "fastp 0.23.4"; still a candidate
# A SIF hash pins one artifact; independent pulls may differ. FASTP_ACCEPT_NEW_SIF=1 adopts a new pull after a
# version check (then update FASTP_SIF_SHA256). Optional: FASTP_IMAGE_DIGEST=sha256:... with an @sha256 URI.

# ---- quantification parameters (collaborator configuration, scripts/tsaolab_melanoma/run_quant.sh) ------
export FASTP_THREADS=4                                         # inferred: collaborator THREADS = salmon threads - 2
export SALMON_THREADS=6                                        # collaborator: THREADS + 2 (cmd_info.json: "threads": "6")
export FASTP_MIN_LENGTH=25
export EXPECT_NUM_TARGETS=253181                               # committed meta_info.json num_valid_targets
export EXPECT_LIBTYPE=ISR                                      # committed lib_format_counts.json expected_format
